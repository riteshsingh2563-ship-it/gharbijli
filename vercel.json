  "outputDirectory": "www",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/admin.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/app", "destination": "/index.html" },
    { "source": "/customer", "destination": "/index.html" },
    { "source": "/preview", "destination": "/index.html" },
    { "source": "/auth-mobile", "destination": "/auth-mobile.html" },
    { "source": "/auth-mobile.html", "destination": "/auth-mobile.html" }
  ]
}
