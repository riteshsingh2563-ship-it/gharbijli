{
  "appId": "me.gharbijli.app",
  "appName": "GharBijli",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#fffaf5",
  "server": {
    "allowNavigation": [
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com",
      "*.firebaseapp.com",
      "ghar-bijli.firebaseapp.com",
      "gharbijli-fwnz.vercel.app"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#fffaf5",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#ffffff"
    }
  }
}
